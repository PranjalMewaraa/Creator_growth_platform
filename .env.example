# Copy to .env at the repo root. Both apps read it in local dev.
# Deployed environments set these in Vercel and on the render VM instead.

NODE_ENV=development
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL=postgres://cgp:cgp@localhost:5432/cgp
REDIS_URL=redis://localhost:6379

# fake | real. Real provider calls spend trial credit; keep fake unless you mean it.
PROVIDERS=fake
