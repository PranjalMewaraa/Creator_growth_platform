# Copy to .env at the repo root. Both apps read it in local dev.
# Deployed environments set these in Vercel and on the render VM instead.

NODE_ENV=development
LOG_LEVEL=debug

# Any Postgres works. Local docker (matches docker-compose.yml):
DATABASE_URL=postgres://cgp:cgp@localhost:5432/cgp
# Or a hosted database such as Neon, with SSL:
# DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

# Signs session cookies and magic link tokens. Generate a fresh one per environment:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=development-only-secret-change-me-32chars
APP_URL=http://localhost:3000

# How mail leaves (WP51). Set one: RESEND_API_KEY for Resend, or SMTP_URL for any SMTP
# relay (a Gmail app password, a workplace relay, or Mailpit locally: smtp://localhost:1025).
# With neither, sign in links are written to the server log instead of emailed.
# EMAIL_FROM is what the message says it is from; Resend's test sender is used if it is unset.
# RESEND_API_KEY=
# SMTP_URL=
# EMAIL_FROM="Creator Growth Platform <hello@yourdomain.example>"

# Optional. Concurrency tests create a throwaway database on this server and drop it afterwards;
# without it they are skipped. Can point at the same server as DATABASE_URL.
# TEST_DATABASE_URL=

# Owner account created by pnpm db:seed.
SEED_OWNER_EMAIL=owner@example.com

# fake | real. Real provider calls spend trial credit; keep fake unless you mean it.
PROVIDERS=fake
# Real calls go through Vertex with application default credentials in this project.
# GOOGLE_CLOUD_PROJECT=
# fake | google. Google is Cloud Natural Language and Vision SafeSearch, both enabled on the
# project above. Fake allows everything except FAKE_BLOCK:<category> markers.
MODERATION=fake
